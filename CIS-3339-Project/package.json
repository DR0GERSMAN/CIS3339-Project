{
  "name": "cis3339-team-project",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "start": "node scripts/run.cjs",
    "demo": "node scripts/run.cjs --demo",
    "demo:production": "node scripts/run.cjs --demo --production",
    "start:production": "node scripts/run.cjs --production",
    "db:init": "npm --prefix backend run db:init",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test && npm --prefix frontend test"
  }
}
