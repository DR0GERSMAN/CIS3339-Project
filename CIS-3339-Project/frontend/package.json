{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "serve": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "@vuelidate/core": "^2.0.0",
    "@vuelidate/validators": "^2.0.0",
    "axios": "^1.3.4",
    "chart.js": "^4.4.0",
    "jwt-decode": "^3.1.2",
    "pinia": "^2.1.6",
    "vue": "^3.2.41",
    "vue-multiselect": "^3.0.0-alpha.2",
    "vue-router": "^4.1.6",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "@vue/compiler-sfc": "^3.2.41",
    "autoprefixer": "^10.4.12",
    "eslint": "^8.26.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.6.0",
    "postcss": "^8.4.18",
    "tailwindcss": "^3.2.6",
    "vite": "^6.4.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "vitest": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "plugin:vue/vue3-essential",
      "prettier"
    ],
    "env": {
      "es2022": true
    },
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "singleQuote": true,
          "trailingComma": "none"
        }
      ],
      "arrow-body-style": "off",
      "prefer-arrow-callback": "off"
    },
    "plugins": [
      "prettier"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=20.19.0"
  }
}
